{
    "target": "esp32s3",
    "builds": [
        {
            "name": "lafvin-aichatbot",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_LANGUAGE_EN_US=y"
            ]
        },
        {
            "name": "lafvin-aichatbot-symbios-terminal",
            "sdkconfig_append": [
                "CONFIG_LAFVIN_MONO_MIC_INPUT=y",
                "CONFIG_LANGUAGE_EN_US=y",
                "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n",
                "CONFIG_SR_WN_WN9_HIESP=y",
                "CONFIG_SYMBIOS_VOICE_GATEWAY=y",
                "CONFIG_SYMBIOS_AUTO_SUBMIT_ON_SILENCE=y",
                "CONFIG_SYMBIOS_SINGLE_TURN=y",
                "CONFIG_SYMBIOS_LISTEN_IDLE_TIMEOUT_MS=30000",
                "CONFIG_SYMBIOS_TERMINAL_TICKER=y",
                "CONFIG_SYMBIOS_TERMINAL_FEED_URL=\"https://symbios-gateway.invalid/api/v1/terminal/feed\"",
                "CONFIG_SYMBIOS_GATEWAY_URL=\"https://symbios-gateway.invalid/xiaozhi/ota/\""
            ]
        }
    ]
}
