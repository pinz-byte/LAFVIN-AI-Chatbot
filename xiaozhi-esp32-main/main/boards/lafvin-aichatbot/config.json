{
    "target": "esp32s3",
    "builds": [
        {
            "name": "lafvin-aichatbot",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_LANGUAGE_EN_US=y"
            ]
        },
        {
            "name": "lafvin-aichatbot-symbios-terminal",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_LANGUAGE_EN_US=y",
                "CONFIG_SYMBIOS_VOICE_GATEWAY=y",
                "CONFIG_SYMBIOS_GATEWAY_URL=\"https://symbios-gateway.invalid/xiaozhi/ota/\""
            ]
        }
    ]
}
