# Public HTTPS origin serving this gateway. TLS may terminate at a reverse proxy.
SYMBIOS_PUBLIC_BASE_URL=https://voice.example.com

# Generate both values independently, for example with: openssl rand -hex 32
SYMBIOS_JWT_SECRET=replace-with-at-least-32-random-characters
SYMBIOS_ADMIN_TOKEN=replace-with-at-least-32-random-characters

# The production gateway terminates Xiaozhi audio and opens Vertex Gemini Live
# server-to-server with the Cloud Run service account. No provider key is used.
SYMBIOS_VOICE_PROVIDER=vertex_live
VERTEX_LIVE_LOCATION=us-central1
VERTEX_LIVE_MODEL=gemini-live-2.5-flash-native-audio

# Use Firestore for Cloud Run so activation/device enrollment survives restarts.
# Local development can use sqlite and SYMBIOS_DB_PATH instead.
SYMBIOS_STORE_BACKEND=firestore
SYMBIOS_GCP_PROJECT=replace-with-gcp-project-id

SYMBIOS_DB_PATH=/data/symbios-gateway.sqlite3
SYMBIOS_SESSION_TTL_SECONDS=300
SYMBIOS_ACTIVATION_TTL_SECONDS=600

# Optional read-only APEX Ultra terminal feed. Inject the ingest token from
# Secret Manager; never place it in ESP32 firmware or device NVS.
SYMBIOS_APEX_INGEST_TOKEN=replace-with-a-dedicated-32-character-secret
SYMBIOS_COINBASE_BASE_URL=https://api.exchange.coinbase.com
SYMBIOS_MARKET_TIMEOUT_SECONDS=4
